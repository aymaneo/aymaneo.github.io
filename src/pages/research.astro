---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const papers = [
  {
    title: 'Medmarks: A Comprehensive Open-Source LLM Benchmark Suite for Medical Tasks',
    description:
      'A comprehensive open-source benchmark suite for evaluating large language models across medical tasks — covering clinical reasoning, diagnosis, and domain-specific knowledge.',
    href: 'https://arxiv.org/abs/2605.01417',
    date: 'May 2026',
    venue: 'arXiv',
    tags: ['Evaluation', 'Medical AI', 'Benchmarks', 'LLMs'],
  },
];
---

<BaseLayout title="Research" description="Research on evaluation and post-training for large language models.">
  <Header />
  <main class="pt-20 pb-28 px-6">
    <div class="max-w-wide mx-auto">
      <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight">Research</h1>
      <p class="mt-4 text-text-secondary text-lg max-w-content">
        Work on evaluation and post-training for large language models.
      </p>

      <section class="mt-16">
        <h2 class="font-heading text-2xl font-bold tracking-tight mb-4">Papers</h2>
        <div class="border-t border-border">
          {
            papers.map((paper) => (
              <a
                href={paper.href}
                target="_blank"
                rel="noopener"
                class="group block py-7 border-b border-border last:border-b-0"
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
                  <div class="shrink-0 sm:w-28">
                    <span class="text-xs font-mono text-text-tertiary">{paper.date}</span>
                    <span class="block text-xs text-text-tertiary">{paper.venue}</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-heading text-base font-semibold tracking-tight group-hover:text-accent transition-colors duration-200">
                      {paper.title}
                      <span class="ml-1.5 text-text-tertiary text-xs">↗</span>
                    </h3>
                    <p class="mt-1 text-sm text-text-secondary leading-relaxed">
                      {paper.description}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {paper.tags.map((tag) => (
                        <span class="text-xs text-text-tertiary border border-border rounded px-2 py-0.5">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
