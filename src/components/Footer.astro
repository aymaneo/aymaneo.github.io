---
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="max-w-wide mx-auto px-6 py-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-text-tertiary">
        &copy; {year} aymaneo
      </p>

      <div class="flex items-center gap-5">
        <a
          href="https://github.com/aymaneo"
          target="_blank"
          rel="noopener"
          class="text-xs text-text-tertiary hover:text-text-secondary transition-colors duration-200"
        >
          GitHub
        </a>
        <a
          href="https://x.com/thelatent_space"
          target="_blank"
          rel="noopener"
          class="text-xs text-text-tertiary hover:text-text-secondary transition-colors duration-200"
        >
          X
        </a>
      </div>
    </div>
  </div>
</footer>
